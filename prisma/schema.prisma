datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  DIREKTOR
  RUKOVODILAC
  MAGACIN
  MEHANICAR
  OPERATER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(OPERATER)
  pin           String?
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  accounts           Account[]
  worker             Worker?
  fieldWorks         FieldWork[]
  machineAssignments MachineAssignment[]
  auditLogs          AuditLog[]

  // Faza 3 relacije
  issuedWorkOrders    WorkOrder[]          @relation("IssuedWorkOrders")
  fuelEntries         FuelEntry[]
  fuelSupplies        FuelSupply[]
  maintenanceIssues   MaintenanceIssue[]
  tollEntries         TollEntry[]
  tollTopUps          TollTopUp[]
  pushSubscriptions   PushSubscription[]

  // Faza 4 relacije
  fertilizerMovements    FertilizerMovement[]
  supervisedSeasonalLogs SeasonalWorkLog[]    @relation("SeasonalSupervisor")

  // Faza 5 relacije (Modul Luk)
  onionHarvestArrivals   OnionHarvestArrival[]
  onionStorageEntries    OnionStorageEntry[]
  onionSortings          OnionSorting[]
  onionPackagings        OnionPackaging[]
  onionShipments         OnionShipment[]
  onionWastes            OnionWaste[]

  @@map("user")
}

// ===== ŠIFARNICI (MASTER DATA) =====

enum WorkerType {
  STALNI
  SEZONAC
}

model Worker {
  id         String     @id @default(cuid())
  name       String
  type       WorkerType @default(STALNI)
  role       Role?      // RUKOVODILAC, MAGACIN, MEHANICAR, OPERATER
  city       String?    // Grad / Mesto stanovanja
  dailyWage  Float?     // Dnevnica u RSD (za sezonce)
  jmbg       String?
  phone      String?
  hourlyRate Float?     @default(0)
  isActive   Boolean    @default(true)
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  fieldWorks         FieldWork[]
  machineAssignments MachineAssignment[]

  // Faza 3 relacije
  workOrders          WorkOrder[]
  fuelEntries         FuelEntry[]
  reportedIssues      MaintenanceIssue[]   @relation("ReportedIssues")
  mechanicIssues      MaintenanceIssue[]   @relation("MechanicIssues")
  tollEntries         TollEntry[]

  // Faza 4 relacije
  fertilizerMovements FertilizerMovement[]

  // Faza 5 relacije (Modul Luk)
  onionHarvestArrivals OnionHarvestArrival[]

  @@map("worker")
}

model Parcel {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  areaHa      Float
  location    String?
  currentCrop String?
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fieldWorks         FieldWork[]
  machineAssignments MachineAssignment[]

  // Faza 3 relacije
  workOrders          WorkOrder[]
  maintenanceIssues   MaintenanceIssue[]

  // Faza 4 relacije
  fertilizerMovements FertilizerMovement[]
  seasonalWorkLogs    SeasonalWorkLog[]

  // Faza 5 relacije (Modul Luk)
  onionLots            OnionLot[]
  onionHarvestArrivals OnionHarvestArrival[]

  @@map("parcel")
}

enum MachineType {
  TRAKTOR
  PRIKLJUCAK
  KOMBAJN
  KAMION
  VILJUSKAR
  OSTALO
}

enum MachineStatus {
  SLOBODNA
  ZADUZENA
  U_KVARU
  SERVIS
}

model Machine {
  id           String        @id @default(cuid())
  name         String
  type         MachineType   @default(TRAKTOR)
  brandModel   String?
  regNumber    String?
  year         Int?
  currentHours Float         @default(0)
  status       MachineStatus @default(SLOBODNA)
  notes        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // Faza 3: Rezervoar goriva u litrima
  tankCapacityLiters Float?  @default(200)
  currentFuelLiters  Float?  @default(0)

  // ENP Tag za putarine (kamioni i prevozna sredstva)
  enpTagNumber       String?
  enpTagBalance      Float?  @default(0)

  fieldWorksAsMachine    FieldWork[]        @relation("FieldWorkMachine")
  fieldWorksAsAttachment FieldWork[]        @relation("FieldWorkAttachment")
  assignments            MachineAssignment[]

  // Faza 3 relacije
  workOrdersAsMachine    WorkOrder[]        @relation("OrderMachine")
  workOrdersAsAttachment WorkOrder[]        @relation("OrderAttachment")
  fuelEntries            FuelEntry[]
  maintenanceIssues      MaintenanceIssue[]
  tollEntries            TollEntry[]
  tollTopUps             TollTopUp[]

  // Faza 5 relacije (Modul Luk)
  onionHarvestArrivals   OnionHarvestArrival[]

  @@map("machine")
}

enum WorkCategory {
  OBRADA
  ZASTITA
  SETVA
  ZETVA_BERBA
  TRANSPORT
  OSTALO
}

model WorkType {
  id                 String       @id @default(cuid())
  name               String       @unique
  category           WorkCategory @default(OBRADA)
  unit               String       @default("ha")
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  // Faza 3: Normativi i cene iz Cenovnika (Rukovodilac i Direktor)
  fuelNormLitersPerHa Float?      // Normativ goriva u lit/ha (npr. 21 za oranje)
  laborPricePerHa     Float?      // Fiksni dinarski deo rada/amortizacije
  totalPricePerHa     Float?      // Ukupna kalkulativna cena bez PDV-a
  referenceFuelPrice  Float?      @default(171.66) // Referentna cena goriva

  fieldWorks FieldWork[]
  workOrders WorkOrder[]

  @@map("work_type")
}

model Crop {
  id        String   @id @default(cuid())
  name      String
  variety   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("crop")
}

enum PartnerType {
  KUPAC
  DOBAVLJAC
  SERVIS
  OBA
}

model Partner {
  id        String      @id @default(cuid())
  name      String
  type      PartnerType @default(KUPAC)
  pib       String?
  phone     String?
  email     String?
  address   String?
  notes     String?
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // Faza 3 relacije ka eksternom servisu / nabavci delova / gorivu
  maintenanceIssues   MaintenanceIssue[]
  fuelSupplies        FuelSupply[]

  // Faza 4 relacije
  fertilizerMovements FertilizerMovement[]

  // Faza 5 relacije (Modul Luk)
  onionShipments      OnionShipment[]

  @@map("partner")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ===== FAZA 2: OPERATIVA NA NJIVI & MAŠINE =====

enum ShiftType {
  PRVA
  DRUGA
  TRECA
}

enum WorkStatus {
  U_TOKU
  ZAVRSENO
  STORNO
}

model FieldWork {
  id           String      @id @default(cuid())
  date         DateTime    @default(now())
  shift        ShiftType   @default(PRVA)
  
  // Relacije ka šifarnicima
  parcelId     String
  parcel       Parcel      @relation(fields: [parcelId], references: [id])
  
  machineId    String
  machine      Machine     @relation("FieldWorkMachine", fields: [machineId], references: [id])
  
  attachmentId String?
  attachment   Machine?    @relation("FieldWorkAttachment", fields: [attachmentId], references: [id])
  
  workerId     String
  worker       Worker      @relation(fields: [workerId], references: [id])
  
  workTypeId   String
  workType     WorkType    @relation(fields: [workTypeId], references: [id])
  
  // Metrika učinka
  areaDoneHa   Float       // Urađeno hektara (validira se: max parcel.areaHa * 1.2)
  startTime    String?     // npr. "07:00"
  endTime      String?     // npr. "15:30"
  workHours    Float?      // Automatski izračunava backend iz startTime/endTime
  
  status       WorkStatus  @default(ZAVRSENO)
  notes        String?
  photoUrl     String?     // Slika sa njive po potrebi
  
  // Faza 3: Veza sa radnim nalogom i sipanim gorivom
  workOrder    WorkOrder?
  fuelEntries  FuelEntry[]

  // Audit trag (Ko je uneo zapis)
  createdById  String
  createdBy    User        @relation(fields: [createdById], references: [id])
  
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([date])
  @@index([parcelId, date])
  @@index([workerId, date])
  @@index([machineId, date])
  @@index([attachmentId, date])
  @@map("field_work")
}

enum AssignmentStatus {
  ZADUZENA
  RAZDUZENA
  VRACENA_SA_KVAROM
}

model MachineAssignment {
  id              String           @id @default(cuid())
  machineId       String
  machine         Machine          @relation(fields: [machineId], references: [id])
  
  workerId        String
  worker          Worker           @relation(fields: [workerId], references: [id])
  
  parcelId        String?
  parcel          Parcel?          @relation(fields: [parcelId], references: [id])
  
  // Podaci o zaduženju
  assignedAt      DateTime         @default(now())
  startFuelLevel  Float?           // Procenat (backward compat)
  startFuelLiters Float?           // Faza 3: Tačan nivo u litrima
  startHours      Float            // Automatski preuzeto iz Machine.currentHours
  assignNotes     String?
  
  // Podaci o razduženju
  returnedAt      DateTime?
  endFuelLevel    Float?           // Procenat (backward compat)
  endFuelLiters   Float?           // Faza 3: Tačan nivo u litrima
  endHours        Float?           // Krajnji radni sati (rh) -> ažurira Machine.currentHours
  isOperational   Boolean          @default(true) // Da li je vraćena ispravna
  returnNotes     String?          // Opis problema ako nije ispravna
  
  status          AssignmentStatus @default(ZADUZENA)
  
  // Povezanost sa radnim nalogom (kada radnik zadužuje mašinu preko naloga)
  workOrderId     String?
  workOrder       WorkOrder?       @relation(fields: [workOrderId], references: [id], onDelete: SetNull)
  
  createdById     String
  createdBy       User             @relation(fields: [createdById], references: [id])
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([machineId, status])
  @@map("machine_assignment")
}

// ===== REVIZORSKI TRAG (AUDIT LOG) =====

model AuditLog {
  id          String   @id @default(cuid())
  entityType  String   // npr. "FieldWork", "WorkOrder"
  entityId    String   // ID unosa koji je menjan
  action      String   // "IZMENA", "STORNO", "KREIRANJE"
  
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName    String   // Denormalizovano ime korisnika
  userRole    String   // DIREKTOR, RUKOVODILAC, OPERATER...
  
  description String   // Sažetak izmene (npr. "Urađena površina: 3.5 ha -> 4.0 ha")
  oldValues   Json?    // Stare vrednosti pre izmene
  newValues   Json?    // Nove vrednosti nakon izmene
  
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_log")
}

// ==========================================
// ===== FAZA 3: NALOZI, GORIVO, KVAROVI =====
// ==========================================

enum OrderType {
  RAD_NJIVA       // Rad na parceli (oranje, prskanje, setva...)
  REMONT_SERVIS   // Radionica, remont, popravka, zamena ulja
  OSTALO          // Magacinski rad, manipulacija robom, transport
}

enum OrderStatus {
  PLANIRAN        // Kreiran uveče za sutrašnji dan
  DODELJEN        // Radnik obavešten (iskače na telefonu)
  U_TOKU          // Radnik započeo rad na njivi / u radionici
  ZAVRSEN         // Rad uspešno okončan i verifikovan
  OTKAZAN         // Otkazano zbog kiše / kvara / promene plana
}

model WorkOrder {
  id              String       @id @default(cuid())
  orderNumber     String       @unique // npr. "RN-2026-0001"
  orderDate       DateTime     // Datum za koji je nalog planiran (npr. sutra)
  orderType       OrderType    @default(RAD_NJIVA)
  status          OrderStatus  @default(PLANIRAN)
  priority        String       @default("NORMALNO") // NORMALNO, HITNO, KRITICNO

  // Kome je nalog izdat
  workerId        String
  worker          Worker       @relation(fields: [workerId], references: [id])

  // Koja mašina i opcioni priključak
  machineId       String?
  machine         Machine?     @relation("OrderMachine", fields: [machineId], references: [id])
  attachmentId    String?
  attachment      Machine?     @relation("OrderAttachment", fields: [attachmentId], references: [id])

  // Gde se radi (za radove na njivi)
  parcelId        String?
  parcel          Parcel?      @relation(fields: [parcelId], references: [id])

  // Koji posao
  workTypeId      String?
  workType        WorkType?    @relation(fields: [workTypeId], references: [id])

  plannedAreaHa   Float?       // Planirano hektara
  shift           ShiftType    @default(PRVA)
  instructions    String?      // Uputstvo poslovođe radniku

  // Povezivanje sa realizacijom kada radnik popuni unos rada
  fieldWorkId     String?      @unique
  fieldWork       FieldWork?   @relation(fields: [fieldWorkId], references: [id])

  // Zaduženja mašine vezana za ovaj nalog
  machineAssignments MachineAssignment[]

  // Povezivanje sa servisnim nalogom (ako je nalog za remont)
  maintenanceId   String?      @unique
  maintenance     MaintenanceIssue? @relation(fields: [maintenanceId], references: [id])

  // Ko je izdao nalog (Rukovodilac ili Direktor)
  issuedById      String
  issuedBy        User         @relation("IssuedWorkOrders", fields: [issuedById], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([orderDate, status])
  @@index([workerId, orderDate])
  @@map("work_order")
}

enum FuelSource {
  CISTERNA       // Interna cisterna u krugu gazdinstva
  PUMPA          // Benzinska pumpa
  KANISTER       // Kanister na njivi
}

model FuelEntry {
  id              String      @id @default(cuid())
  date            DateTime    @default(now())

  machineId       String
  machine         Machine     @relation(fields: [machineId], references: [id])

  workerId        String
  worker          Worker      @relation(fields: [workerId], references: [id])

  fieldWorkId     String?
  fieldWork       FieldWork?  @relation(fields: [fieldWorkId], references: [id])

  fuelSource      FuelSource  @default(CISTERNA)
  gasStation      String?     // Za javne pumpe: "PETROL", "EUROPETROL"
  fuelType        String      @default("EURODIZEL") // EURODIZEL, EURODIZEL ADITIVNI
  liters          Float       // Količina u litrima (obavezno)

  // Finansijska polja (vidljiva samo direktoru i rukovodiocu)
  pricePerLiter   Float?      // Nabavna cena po litru
  totalCost       Float?      // litara * cenaPoLitru
  receiptImageUrl String?     // Link ka slici računa na Bunny.net CDN-u

  // Detekcija prekomerne potrošnje u odnosu na normativ iz cenovnika
  hasAnomaly      Boolean     @default(false)
  anomalyReason   String?     // npr. "Potrošnja 34 l/ha prelazi normativ od 21 l/ha"

  receiptNumber   String?     // Broj računa / otpremnice
  notes           String?

  createdById     String
  createdBy       User        @relation(fields: [createdById], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([machineId, date])
  @@index([date])
  @@index([gasStation])
  @@map("fuel_entry")
}

model FuelSupply {
  id              String      @id @default(cuid())
  date            DateTime    @default(now())
  fuelType        String      @default("EURODIZEL") // EURODIZEL, EURODIZEL ADITIVNI
  liters          Float       // Količina u litrima (npr. 5000)
  pricePerLiter   Float       // Nabavna cena po litru (npr. 185 RSD)
  totalCost       Float       // liters * pricePerLiter
  supplierId      String?
  supplier        Partner?    @relation(fields: [supplierId], references: [id])
  supplierName    String?     // Ime dobavljača ako nije u partnerima
  receiptNumber   String?     // Broj računa / otpremnice
  notes           String?

  createdById     String
  createdBy       User        @relation(fields: [createdById], references: [id])

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([date])
  @@map("fuel_supply")
}

enum IssuePriority {
  NISKA          // Može da sačeka kraj sezone (klima, brisač)
  SREDNJA        // Servisirati uskoro (redovan servis ulja za 30 rh)
  VISOKA         // Hitna intervencija (pregrevanje, labav kaiš)
  KRITICNA       // Mašina stoji na njivi, prekid rada!
}

enum IssueStatus {
  OTVOREN        // Prijavljen kvar sa terena
  U_RADU         // Mehaničar na terenu ili u radionici radi popravku
  CEKA_DELOVE    // Naručeni delovi od dobavljača (Agro-partneri)
  POPRAVLJENO    // Popravka završena, mašina testirana i oslobođena
  OTKAZAN        // Lažna uzbuna / dupli unos
}

enum ServiceType {
  KVAR_NJIVA     // Vanredni kvar na terenu
  REDOVAN_SERVIS // Redovna zamena ulja i filtera
  GENERALNI_REMONT // Veliki godišnji remont mehanizacije
}

model MaintenanceIssue {
  id               String          @id @default(cuid())
  dateReported     DateTime        @default(now())
  serviceType      ServiceType     @default(KVAR_NJIVA)
  priority         IssuePriority   @default(SREDNJA)
  status           IssueStatus     @default(OTVOREN)

  machineId        String
  machine          Machine         @relation(fields: [machineId], references: [id])

  parcelId         String?
  parcel           Parcel?         @relation(fields: [parcelId], references: [id])

  reportedById     String
  reportedBy       Worker          @relation("ReportedIssues", fields: [reportedById], references: [id])

  mechanicId       String?
  mechanic         Worker?         @relation("MechanicIssues", fields: [mechanicId], references: [id])

  servicePartnerId String?
  servicePartner   Partner?        @relation(fields: [servicePartnerId], references: [id])

  isMachineStopped Boolean         @default(false)
  downtimeHours    Float?          @default(0) // Koliko sati je mašina stajala

  title            String          // Kratak opis kvara/servisa
  description      String?         // Detalji kvara sa njive
  photoUrl         String?         // Fotografija problema sa telefona

  repairedAt       DateTime?
  repairNotes      String?         // Izveštaj mehaničara o urađenoj popravci
  partsReplaced    String?         // Tekstualni spisak zamenjenih delova
  
  // Utrošena ulja i maziva iz šifarnika (Hidrol-46, Total Dynatrans MPV, Motorno 15W-40)
  lubricantType    String?         // npr. "TOTAL DYNATRANS MPV"
  lubricantLiters  Float?          // Utrošeno litara maziva

  partsCost        Float?          @default(0) // Trošak delova (RSD)
  laborCost        Float?          @default(0) // Rad eksternog servisa (RSD)
  totalCost        Float?          @default(0) // Ukupno ulaganje (delovi + rad)
  invoicePhotoUrl  String?         // Slika računa / fakture za delove

  workOrder        WorkOrder?

  createdById      String
  createdBy        User            @relation(fields: [createdById], references: [id])

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([machineId, status])
  @@index([parcelId, status])
  @@index([status])
  @@map("maintenance_issue")
}

// ==========================================
// ===== PUTARINE I ENP TAGOVI (KAMIONI) ====
// ==========================================

model TollEntry {
  id              String   @id @default(cuid())
  date            DateTime @default(now())

  machineId       String
  machine         Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  workerId        String
  worker          Worker   @relation(fields: [workerId], references: [id])

  amount          Float    // Iznos putarine u RSD
  paymentMethod   String   @default("ENP_TAG") // ENP_TAG, GOTOVINA, KARTICA
  tagNumber       String?  // Broj ENP taga (npr. sa kamiona)

  entryStation    String?  // Ulazna rampa (npr. Novi Sad)
  exitStation     String?  // Izlazna rampa (npr. Beograd)
  routeRelation   String?  // Relacija / deonica (npr. Novi Sad - Beograd)
  receiptNumber   String?  // Broj priznanice / računa
  notes           String?

  createdById     String
  createdBy       User     @relation(fields: [createdById], references: [id])

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([machineId, date])
  @@index([workerId, date])
  @@index([date])
  @@map("toll_entry")
}

model TollTopUp {
  id               String   @id @default(cuid())
  date             DateTime @default(now())

  machineId        String
  machine          Machine  @relation(fields: [machineId], references: [id], onDelete: Cascade)

  tagNumber        String?  // Broj ENP taga
  amount           Float    // Uplaćeni iznos dopune u RSD
  paymentReference String?  // Broj fakture / predračuna / uplatnice
  notes            String?

  createdById      String
  createdBy        User     @relation(fields: [createdById], references: [id])

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([machineId, date])
  @@index([date])
  @@map("toll_top_up")
}

// ==========================================
// WEB PUSH NOTIFIKACIJE
// ==========================================

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscription")
}

// ==========================================
// FAZA 4: MAGACIN ĐUBRIVA & ZALIHE
// ==========================================

enum FertilizerType {
  MINERALNO_GRANULISANO    // NPK, UREA, KAN, AN, MAP
  VODOTOPIVO_FERTIRIGACIJA // Kristaloni za kap-po-kap
  TECNI_BIOSTIMULATOR      // Folijarna prihrana, aminokiseline
  ORGANSKO_PELETIRANO      // Stajnjak, organska đubriva
}

enum FertilizerUnit {
  KG
  L
  TONA
}

enum StockMovementType {
  PRIJEM_NABAVKA           // Ulaz od dobavljača
  IZDAVANJE_NJIVA          // Izlaz na parcelu
  POVRAT_SA_NJIVE          // Višak vraćen u magacin
  OTPIS_KOREKCIJA          // Kalo, oštećena ambalaža
}

model FertilizerProduct {
  id                  String               @id @default(cuid())
  name                String               @unique // npr. "YaraMila Complex 12-11-18"
  type                FertilizerType       @default(MINERALNO_GRANULISANO)
  unit                FertilizerUnit       @default(KG)

  // Zalihe
  currentStock        Float                @default(0)   // Trenutno na stanju u magacinu
  minStockWarning     Float                @default(500) // Prag za crveni alarm (npr. 500 kg)

  // Finansije
  defaultPricePerUnit Float?               @default(0)   // Prosečna nabavna cena po kg/L (RSD)

  // Skladište
  defaultLocation     String?              // npr. "Sektor A - Boks 3"
  description         String?              // N-P-K sastav, namena
  isActive            Boolean              @default(true)

  movements           FertilizerMovement[]

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@map("fertilizer_product")
}

model FertilizerMovement {
  id                String            @id @default(cuid())
  date              DateTime          @default(now())
  movementType      StockMovementType @default(IZDAVANJE_NJIVA)

  productId         String
  product           FertilizerProduct @relation(fields: [productId], references: [id])

  quantity          Float             // Količina (uvek pozitivna vrednost)
  unitPrice         Float?            // Nabavna cena po jedinici u momentu transakcije
  totalCost         Float?            // quantity * unitPrice

  // Podaci za prijem (Nabavka)
  supplierId        String?
  supplier          Partner?          @relation(fields: [supplierId], references: [id])
  receiptNumber     String?           // Broj otpremnice / računa dobavljača
  warehouseLocation String?           // Lokacija gde je roba spakovana

  // Podaci za izdavanje na njivu
  parcelId          String?
  parcel            Parcel?           @relation(fields: [parcelId], references: [id])
  cropName          String?           // Kultura koja se đubri (npr. "Žuti luk")
  areaHa            Float?            // Površina na koju se baca
  kgPerHa           Float?            // Automatski: quantity (u kg/L) / areaHa

  // Lica
  issuedById        String            // Korisnik koji izdaje/prima robu u magacinu
  issuedBy          User              @relation(fields: [issuedById], references: [id])

  receivedWorkerId  String?           // Traktorista / radnik koji je preuzeo/vratio đubrivo
  receivedWorker    Worker?           @relation(fields: [receivedWorkerId], references: [id])

  notes             String?           // Dodatna napomena
  createdAt         DateTime          @default(now())

  @@index([productId, date])
  @@index([parcelId, date])
  @@index([movementType])
  @@map("fertilizer_movement")
}

// ==========================================
// FAZA 4: SEZONSKI RADNICI & EVIDENCIJA RADA
// ==========================================

model SeasonalGroup {
  id          String   @id @default(cuid())
  name        String   @unique           // Jedinstveni naziv grupe (npr. "Grupa Kulpin")
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seasonal_group")
}

model SeasonalWorker {
  id              String            @id @default(cuid())
  name            String            // Ime i prezime sezonca
  phone           String?           // Broj telefona
  city            String?           // Mesto / grad
  
  groupName       String?           // Naziv posade/grupe (opciono, npr. "Grupa Agim")
  dailyWage       Float?            // Dnevnica u RSD (opciono)
  
  isActive        Boolean           @default(true)
  notes           String?
  
  workLogs        SeasonalWorkLog[]
  
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([name])
  @@index([groupName])
  @@map("seasonal_worker")
}

model SeasonalWorkLog {
  id                String          @id @default(cuid())
  date              DateTime        @default(now())
  
  seasonalWorkerId  String
  seasonalWorker    SeasonalWorker  @relation(fields: [seasonalWorkerId], references: [id], onDelete: Cascade)
  
  parcelId          String?
  parcel            Parcel?         @relation(fields: [parcelId], references: [id], onDelete: SetNull)
  
  jobDescription    String          // npr. "Plevljenje luka", "Sečenje peruške", "Vađenje i pakovanje"
  
  // Radno vreme
  startTime         String?         // npr. "07:00"
  endTime           String?         // npr. "15:30"
  breakMinutes      Int             @default(0) // Opciona pauza u minutima (npr. 30)
  hoursWorked       Float           // Efektivni sati rada (npr. 8.0)
  
  // Finansije (opciono)
  dailyWageApplied  Float?          // Dnevnica za taj dan (opciono)
  
  // Nadzor
  supervisorId      String          // Poslovođa / rukovodilac sa terena
  supervisor        User            @relation("SeasonalSupervisor", fields: [supervisorId], references: [id])
  
  // Podaci o posadi / grupi
  groupName         String?         // Naziv posade ako je rad unet kao deo grupe
  groupCount        Int?            // Broj ljudi u posadi tog dana
  
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([seasonalWorkerId, date])
  @@index([parcelId, date])
  @@index([date])
  @@map("seasonal_work_log")
}

// ==========================================
// FAZA 5: MODUL LUK — TOK ROBE & SLEDLJIVOST
// ==========================================

enum OnionLotStatus {
  NA_STANJU      // Luk je na stanju (sirovina ili gotov proizvod)
  U_OBRADI       // U procesu sortiranja / pakovanja
  ISPORUCEN      // Ceo LOT je isporučen kupcima
  ARHIVIRAN      // Završena sezona
}

enum OnionStorageType {
  HLADNJACA
  MAGACIN
}

enum OnionPackageType {
  DZAK_5KG
  DZAK_10KG
  DZAK_25KG
  DZAMBO_VRECA
  BOKS_PALETA
  RINFUZ
  DRUGO
}

enum OnionWasteReason {
  TRULEZ
  MEHANICKO_OSTECENJE
  KALO_SUSENJE
  PROKLIJAO
  PRLJAVSTINA_ZEMLJA
  OSTALO
}

// 1. Centralni LOT Zapis
model OnionLot {
  id                  String          @id @default(cuid())
  lotNumber           String          @unique // npr. "LOT-20261029-P01-01"
  status              OnionLotStatus  @default(NA_STANJU)
  
  // Veza sa njivom
  parcelId            String
  parcel              Parcel          @relation(fields: [parcelId], references: [id])
  cropVariety         String?         // npr. "Žuti holandski", "Srebrenac", "Crveni"
  
  // Početna masa i trenutni zbirovi
  initialQuantityKg   Float           // Ukupno dovezeno sa njive
  rawStockKg          Float           // Trenutno preostalo nesortiranog luka (hladnjača + magacin)
  sortedQualityKg     Float           @default(0) // Ukupno sortirano I klase
  sortedSmallKg       Float           @default(0) // Ukupno sitnog luka
  sortedWasteKg       Float           @default(0) // Ukupno škarta/otpada na sortiranju
  packagedStockKg     Float           @default(0) // Trenutno na stanju spakovanog (neshipped)
  shippedKg           Float           @default(0) // Ukupno isporučeno kupcima
  totalWasteKg        Float           @default(0) // Ukupan otpis (sortiranje + skladište)

  notes               String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  harvestArrivals     OnionHarvestArrival[]
  storageEntries      OnionStorageEntry[]
  sortings            OnionSorting[]
  packagings          OnionPackaging[]
  shipments           OnionShipment[]
  wastes              OnionWaste[]

  @@index([lotNumber])
  @@index([parcelId])
  @@index([status])
  @@map("onion_lot")
}

// 2. Dovoz sa njive
model OnionHarvestArrival {
  id              String    @id @default(cuid())
  date            DateTime  @default(now())
  
  lotId           String
  lot             OnionLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  
  parcelId        String
  parcel          Parcel    @relation(fields: [parcelId], references: [id])
  
  quantityKg      Float     // Količina ture (kg)
  
  // Prevoz
  vehicleId       String?   // Mašina / Kamion / Traktor
  vehicle         Machine?  @relation(fields: [vehicleId], references: [id])
  driverId        String?   // Vozač / Traktorista
  driver          Worker?   @relation(fields: [driverId], references: [id])
  trailerInfo     String?   // Broj prikolice / registracija
  
  supervisorId    String    // Ko je evidentirao ulaz
  supervisor      User      @relation(fields: [supervisorId], references: [id])
  
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([lotId, date])
  @@index([parcelId])
  @@map("onion_harvest_arrival")
}

// 3. Skladištenje u Hladnjaču / Magacin
model OnionStorageEntry {
  id                  String            @id @default(cuid())
  date                DateTime          @default(now())
  
  lotId               String
  lot                 OnionLot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  
  storageType         OnionStorageType  @default(HLADNJACA)
  locationOrChamber   String            // npr. "Komora 1", "Komora 2", "Komora 4"
  hasEquipment        Boolean           @default(true) // Komore 1-3 sa opremom, Komore 4-6 bez opreme
  boxCount            Int?              // Broj boks paleta (dim 160x120x120, ~1100kg po boksu, max 720 po komori)
  
  quantityKg          Float             // Količina uneta u lokaciju
  currentQuantityKg   Float             // Koliko je trenutno ostalo na toj lokaciji
  
  temperatureC        Float?            // Temperatura komore (°C)
  humidityPercent     Float?            // Vlažnost vazduha (%)
  
  supervisorId        String
  supervisor          User              @relation(fields: [supervisorId], references: [id])
  
  notes               String?
  createdAt           DateTime          @default(now())

  @@index([lotId, storageType])
  @@map("onion_storage_entry")
}

// 4. Sortiranje & Kalibracija
model OnionSorting {
  id                  String    @id @default(cuid())
  date                DateTime  @default(now())
  
  lotId               String
  lot                 OnionLot  @relation(fields: [lotId], references: [id], onDelete: Cascade)
  
  inputQuantityKg     Float     // Koliko sirovog luka je ubačeno na liniju
  
  // Izlazne frakcije
  qualityQuantityKg   Float     // I Klasa (Kvalitetan, krupan luk za pakovanje)
  smallQuantityKg     Float     @default(0) // II Klasa (Sitan luk / Arpadžik / Industrija)
  wasteQuantityKg     Float     @default(0) // Loš / Truo / Zemlja / Škart
  wastePercentage     Float     @default(0) // (wasteQuantityKg / inputQuantityKg) * 100
  
  storageEntryId      String?   // Sa koje lokacije/komore je uzet luk
  
  supervisorId        String
  supervisor          User      @relation(fields: [supervisorId], references: [id])
  
  notes               String?
  createdAt           DateTime  @default(now())

  @@index([lotId, date])
  @@map("onion_sorting")
}

// 5. Pakovanje
model OnionPackaging {
  id                  String            @id @default(cuid())
  date                DateTime          @default(now())
  
  lotId               String
  lot                 OnionLot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  
  packageType         OnionPackageType  @default(DZAK_10KG)
  unitWeightKg        Float             // 5, 10, 25, itd.
  packageCount        Int               // Broj vreća/džakova (npr. 500)
  totalWeightKg       Float             // packageCount * unitWeightKg (npr. 5.000 kg)
  
  availableCount      Int               // Preostalo neshipped komada
  availableWeightKg   Float             // Preostalo neshipped kg
  
  palletsCount        Float?            // Broj paleta (npr. 1 paleta = 100 džakova x 10kg ili 200 džakova x 5kg)
  palletNumber        String?           // Broj palete / oznaka lokacije gotove robe
  packerCount         Int               @default(4) // Broj radnika/žena na pakerici (default 4, izmenljivo)
  packerNotes         String?           // Napomena za pakericu / postavu
  responsiblePerson   String?           @default("Bojan Ćorović") // Zadužen za ulaz, izlaz i pakovanje luka
  
  supervisorId        String
  supervisor          User              @relation(fields: [supervisorId], references: [id])
  
  notes               String?
  createdAt           DateTime          @default(now())

  shipmentItems       OnionShipmentItem[]

  @@index([lotId, packageType])
  @@map("onion_packaging")
}

// 6. Isporuka Kupcu & Otpremnica
model OnionShipment {
  id                  String              @id @default(cuid())
  date                DateTime            @default(now())
  dispatchNumber      String              @unique // Broj otpremnice (npr. "OTP-2026/001")
  
  buyerId             String              // Kupac iz šifarnika partnera
  buyer               Partner             @relation(fields: [buyerId], references: [id])
  
  lotId               String              // Povezani LOT
  lot                 OnionLot            @relation(fields: [lotId], references: [id])
  
  totalWeightKg       Float               // Ukupna neto masa isporuke
  totalPackagesCount  Int                 // Ukupan broj džakova/vreća
  pricePerKg          Float?              // Ugovorena prodajna cena po kg (RSD ili EUR)
  totalValue          Float?              // totalWeightKg * pricePerKg
  
  // Transport i vozač
  vehicleReg          String?             // Kamion / kombi kupca ili naš
  driverName          String?             // Vozač koji je preuzeo robu
  
  supervisorId        String              // Ko je izdao robu
  supervisor          User                @relation(fields: [supervisorId], references: [id])
  
  notes               String?
  createdAt           DateTime            @default(now())

  items               OnionShipmentItem[]

  @@index([buyerId, date])
  @@index([lotId])
  @@map("onion_shipment")
}

model OnionShipmentItem {
  id                  String          @id @default(cuid())
  shipmentId          String
  shipment            OnionShipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  packagingId         String
  packaging           OnionPackaging  @relation(fields: [packagingId], references: [id])
  
  packageCount        Int             // Koliko džakova ovog pakovanja je otišlo
  totalWeightKg       Float           // Ukupno kg
  
  @@map("onion_shipment_item")
}

// 7. Otpis & Kalo
model OnionWaste {
  id                  String            @id @default(cuid())
  date                DateTime          @default(now())
  
  lotId               String
  lot                 OnionLot          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  
  quantityKg          Float             // Količina otpisa u kg
  reason              OnionWasteReason  @default(TRULEZ)
  description         String?           // Detaljan opis razloga
  
  location            String?           // Gde je uočen otpis (npr. "Komora 2")
  
  supervisorId        String
  supervisor          User              @relation(fields: [supervisorId], references: [id])
  
  notes               String?
  createdAt           DateTime          @default(now())

  @@index([lotId, reason])
  @@map("onion_waste")
}
